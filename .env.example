# --- Core ---------------------------------------------------------------
# "development" (default) or "production". Production turns on secure cookies
# + https and requires the few vars below. On Render this is auto-detected.
APP_ENV=development

# Optional. If unset, a persistent key is generated and stored in the database
# on first boot, so you don't have to manage one. To pin your own:
# python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# --- Database -------------------------------------------------------------
# Leave unset locally to use SQLite (firstlight-dev.db in the project root).
# On Render this is injected from the managed Postgres database. REQUIRED in
# production (the app refuses to start on ephemeral SQLite there).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Email (REQUIRED in production) ----------------------------------------
# Option A (recommended on Render): Brevo transactional HTTP API.
# Create an account at https://www.brevo.com → SMTP & API → API Keys.
BREVO_API_KEY=

# Optional. Transactional template IDs (Brevo → Transactional → Templates → #).
# Welcome (#2): after email verified — {{ params.VORNAME }}
# Confirm (#3): 6-digit signup code — {{ params.CODE }}
# Receipt (#4): after product purchase (not subscription) —
#   {{ params.ORDER_ID }} {{ params.PRODUCT_NAME }} {{ params.AMOUNT }} {{ params.ORDER_DATE }}
# Healing (#5): first Healing membership join —
#   {{ params.PLAN_PRICE }} {{ params.BILLING_INTERVAL }}
# Creator (#6): first Creator membership join —
#   {{ params.PLAN_PRICE }} {{ params.BILLING_INTERVAL }}
# Card declined (#7): membership renewal charge failed —
#   {{ params.PLAN_NAME }} {{ params.GRACE_DAYS }}
# Cancel (#8): member cancels subscription —
#   {{ params.PLAN_NAME }} {{ params.ACCESS_END_DATE }}
# Newsletter (#9): new Sunday letter signup (no params)
# General (#10): anything without a dedicated template —
#   {{ params.HEADER }} {{ params.TITLE }} {{ params.BODY }}
#   {{ params.BUTTON_TEXT }} {{ params.BUTTON_URL }}
# Support booked (#11): peer support seat saved —
#   {{ params.GROUP_TOPIC }} {{ params.SESSION_DATE }} {{ params.SESSION_TIME }}
# Support left (#12): member releases their seat —
#   {{ params.GROUP_TOPIC }} {{ params.SESSION_DATE }}
# Support reminder (#13): 24h before the peer session —
#   {{ params.GROUP_TOPIC }} {{ params.HOST_NAME }} {{ params.SESSION_DATE }}
#   {{ params.SESSION_TIME }} {{ params.BUTTON_URL }}
# Support host cancel (#14): host cancelled the peer session —
#   {{ params.GROUP_TOPIC }} {{ params.SESSION_DATE }}
# Facilitator booked (#15): facilitator-led seat confirmed —
#   {{ params.SESSION_DATE }} {{ params.SESSION_TIME }} {{ params.AMOUNT }}
# 1:1 booked (#16): private session with a founder —
#   {{ params.COACH_NAME }} {{ params.SESSION_DATE }} {{ params.SESSION_TIME }}
#   {{ params.AMOUNT }} {{ params.BUTTON_URL }}
# Facilitator cancelled (#17): host cancelled a facilitator-led session —
#   {{ params.SESSION_DATE }} {{ params.AMOUNT }}
# 1:1 cancelled (#18): host cancelled a founder 1:1 —
#   {{ params.COACH_NAME }} {{ params.SESSION_DATE }} {{ params.AMOUNT }}
# Full Bloom (#19): first Full Bloom membership join —
#   {{ params.PLAN_PRICE }} {{ params.BILLING_INTERVAL }}
# Customer support (#20): answering someone directly, no CTA button —
#   {{ params.SUBJECT }} {{ params.PREVIEW }} {{ params.HEADER }}
#   {{ params.TITLE }} {{ params.BODY }}
# Reply as Saman (#21) / as Ayesha (#22): same params as #20, their face on it
# Challenge welcome (#30): the hello that goes out beside the receipt when
#   somebody buys the challenge —
#   {{ params.PRODUCT_NAME }} {{ params.ORDER_ID }} {{ params.ORDER_DATE }}
#   {{ params.PRODUCT_DESCRIPTION }} {{ params.MEMBERSHIP_INCLUDED }}
#   {{ params.CHALLENGE_URL }} {{ params.LIBRARY_URL }}
#
# Every id below is a default the app already uses, whether or not the line is
# uncommented — so each one needs to exist in Brevo. A template that isn't
# there is not a lost email: the send is retried in the plain house style and
# the failure is logged. It just won't be the design you drew.
# BREVO_TEMPLATE_WELCOME=2
# BREVO_TEMPLATE_CONFIRM=3
# BREVO_TEMPLATE_RECEIPT=4
# BREVO_TEMPLATE_HEALING=5
# BREVO_TEMPLATE_CREATOR=6
# BREVO_TEMPLATE_CARD_DECLINED=7
# BREVO_TEMPLATE_CANCEL=8
# BREVO_TEMPLATE_NEWSLETTER=9
# BREVO_TEMPLATE_GENERAL=10
# BREVO_TEMPLATE_SUPPORT_BOOKED=11
# BREVO_TEMPLATE_SUPPORT_LEFT=12
# BREVO_TEMPLATE_SUPPORT_REMINDER=13
# BREVO_TEMPLATE_SUPPORT_HOST_CANCEL=14
# BREVO_TEMPLATE_FACILITATOR_BOOKED=15
# BREVO_TEMPLATE_ONE_ON_ONE_BOOKED=16
# BREVO_TEMPLATE_FACILITATOR_CANCELLED=17
# BREVO_TEMPLATE_ONE_ON_ONE_CANCELLED=18
# BREVO_TEMPLATE_FULL_BLOOM=19
# BREVO_TEMPLATE_CUSTOMER_SUPPORT=20
# BREVO_TEMPLATE_REPLY_CREATOR=21
# BREVO_TEMPLATE_REPLY_HEALING=22
# BREVO_TEMPLATE_CHALLENGE_WELCOME=30
# Optional absolute site URL for CTA links when sending outside a web request:
# PUBLIC_BASE_URL=https://www.bloomanyway.online
# Days of access after a failed renewal before membership is cancelled (default 5):
# MEMBERSHIP_GRACE_DAYS=5

# Option B: any SMTP relay. Only used when BREVO_API_KEY is empty.
# Port 465 uses SSL, others STARTTLS. Leave empty in local dev to print emails
# to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The "From" address. Must use a sender/domain verified in Brevo, e.g.
# Bloom Anyway <hello@yourdomain.com>.
# Contact-form messages go to the admin account claimed at /setup.
MAIL_FROM="Bloom Anyway <hello@example.com>"

# --- Cloudflare Turnstile (signup) -----------------------------------------
# Site key is the existing dashboard widget. Secret must match that widget —
# set TURNSTILE_SECRET in Render (never commit the value).
TURNSTILE_SITE_KEY=0x4AAAAAAEAGFowmHgyFM5Kf
TURNSTILE_SECRET=

# --- Stripe (courses, guides, memberships) ---------------------------------
# Dashboard → Developers → API keys / Webhooks.
# Webhook URL MUST use the canonical host (www), not the apex redirect:
#   https://www.bloomanyway.online/webhooks/stripe
# Apex bloomanyway.online returns Cloudflare 307 → Stripe marks delivery failed.
# After creating/editing that endpoint, copy its Signing secret (whsec_…) into
# STRIPE_WEBHOOK_SECRET on Render and redeploy — a secret from an old/apex
# endpoint returns 401 and Stripe keeps pending_webhooks > 0.
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         invoice.paid, invoice.payment_failed, charge.refunded,
#         customer.subscription.deleted, customer.subscription.updated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: self-hosted shop files referenced by ShopPurchase.file_key
# Default when empty: instance/shop_files/
# SHOP_FILES_DIR=

# --- Daily.co (embedded support-group rooms) ---------------------------------
# API key: https://dashboard.daily.co/ → Developers
DAILY_API_KEY=
# Optional: used only for stub room URLs in local/tests (your Daily subdomain).
# DAILY_DOMAIN=bloomanyway
# Optional meeting length in minutes (default 30).
# DAILY_MEETING_DURATION=30

# Optional: shared secret for GET/POST /cron/support-groups (session reminders).
# CRON_SECRET=

# Optional: where uploaded Content Hub videos are stored (Render uses /var/media/videos).
# VIDEO_STORAGE_DIR=
# Cloudflare Free rejects request bodies over ~100 MB before Flask sees them.
# Keep this under 95 so owners get a clear in-app message instead of a blank 413.
# MAX_VIDEO_MB=95

# Members' raw reel uploads (reel reviews and Reel of the Week). Their own
# folder because everything in it is cleared out weekly; defaults to a
# reel_raw folder beside the videos one. They go up a slice at a time, so the
# cap is not the request body limit and only REEL_CHUNK_MB has to stay under
# Cloudflare's ~100 MB. A browser with no JavaScript still posts the file
# whole, and the server caps that at 90 MB whatever is set here.
# REEL_RAW_DIR=
# REEL_RAW_MAX_MB=2048
# REEL_CHUNK_MB=8
